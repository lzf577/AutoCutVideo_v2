# ========== Google Gemini 官方 API 配置 ==========
# 1. 获取 API Key: https://aistudio.google.com/apikey
# 2. 复制此文件为 .env，填入实际的 API Key 和配置

GEMINI_API_KEY=your_actual_gemini_api_key_here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-2.5-flash

# ========== 可用的 Gemini 模型列表 ==========
# gemini-2.5-flash          - 快速、轻量（推荐新手使用）
# gemini-2.5-pro            - 高精度、费用较高
# gemini-2.5-flash-lite     - 超轻量版本
# gemini-1.5-flash          - 前代快速版本
# gemini-1.5-pro            - 前代高精度版本

# ========== 音频提取设置 ==========
AUDIO_BITRATE=128k  # 可选值: 8k, 16k, 32k, 64k, 128k, 192k

# ========== 字幕生成设置 ==========
SUBTITLE_LANGUAGE=自动检测 (Auto)  # 简体中文, 繁体中文, 英文, 自动检测
MAX_CHARS_PER_LINE=30  # 每行最多字数

# ========== 字体设置 ==========
SUBTITLE_FONT=微软雅黑  # Windows 字体名称
