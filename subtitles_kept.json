[
  {
    "id": 1,
    "timestamp": "00:00:00,000 --> 00:00:03,440",
    "text": "大家好，欢迎来到我的频道，大号球场放大镜"
  },
  {
    "id": 5,
    "timestamp": "00:00:13,440 --> 00:00:17,120",
    "text": "重点聚焦两场绝对吸引眼球的北欧赛事"
  },
  {
    "id": 6,
    "timestamp": "00:00:17,120 --> 00:00:19,920",
    "text": "一场是芬超里亚罗对阵塞伊奈约基"
  },
  {
    "id": 7,
    "timestamp": "00:00:19,920 --> 00:00:23,560",
    "text": "另一场是瑞超·韦斯特罗斯·对阵厄尔格里特"
  },
  {
    "id": 16,
    "timestamp": "00:00:47,280 --> 00:00:48,920",
    "text": "芬超分析"
  },
  {
    "id": 17,
    "timestamp": "00:00:48,920 --> 00:00:52,240",
    "text": "焦点全在这场保级大战上"
  },
  {
    "id": 18,
    "timestamp": "00:00:52,240 --> 00:00:55,520",
    "text": "亚罗坐镇主场迎战塞伊奈约基"
  },
  {
    "id": 22,
    "timestamp": "00:01:04,379 --> 00:01:10,220",
    "text": "这场比赛咱们可是严格把它定性为极度危险的泥潭局"
  },
  {
    "id": 30,
    "timestamp": "00:01:27,180 --> 00:01:30,300",
    "text": "战术上看这两边简直就是互相折磨"
  },
  {
    "id": 31,
    "timestamp": "00:01:30,300 --> 00:01:31,500",
    "text": "完美互克"
  },
  {
    "id": 33,
    "timestamp": "00:01:33,500 --> 00:01:35,020",
    "text": "一门心思摆大巴"
  },
  {
    "id": 34,
    "timestamp": "00:01:35,020 --> 00:01:37,500",
    "text": "主打一个五四一的超深防线"
  },
  {
    "id": 35,
    "timestamp": "00:01:37,500 --> 00:01:39,060",
    "text": "边路完全不主动压上"
  },
  {
    "id": 37,
    "timestamp": "00:01:40,940 --> 00:01:43,220",
    "text": "死死掐断你的传控路线"
  },
  {
    "id": 39,
    "timestamp": "00:01:44,500 --> 00:01:46,500",
    "text": "虽然平时控球率看着挺唬人"
  },
  {
    "id": 40,
    "timestamp": "00:01:46,500 --> 00:01:48,060",
    "text": "也擅长阵地战推进"
  },
  {
    "id": 41,
    "timestamp": "00:01:48,060 --> 00:01:50,180",
    "text": "但一碰到这种低位密集防守"
  },
  {
    "id": 43,
    "timestamp": "00:01:51,340 --> 00:01:53,460",
    "text": "锋线的单兵爆破能力根本不够看"
  },
  {
    "id": 47,
    "timestamp": "00:01:59,740 --> 00:02:02,420",
    "text": "亚罗最近在主场的防守叫一个硬"
  },
  {
    "id": 48,
    "timestamp": "00:02:02,420 --> 00:02:04,380",
    "text": "连着两场零封对手"
  },
  {
    "id": 49,
    "timestamp": "00:02:04,380 --> 00:02:05,620",
    "text": "连国际图尔库"
  },
  {
    "id": 50,
    "timestamp": "00:02:05,620 --> 00:02:07,980",
    "text": "这种强队都没能占到便宜"
  },
  {
    "id": 51,
    "timestamp": "00:02:07,980 --> 00:02:11,100",
    "text": "他们主场场均还能偷个1.38球"
  },
  {
    "id": 54,
    "timestamp": "00:02:14,340 --> 00:02:17,140",
    "text": "场均丢1.75个球就不说了"
  },
  {
    "id": 55,
    "timestamp": "00:02:17,140 --> 00:02:18,580",
    "text": "最要命的是最近五场"
  },
  {
    "id": 56,
    "timestamp": "00:02:18,580 --> 00:02:20,020",
    "text": "有二场交了白卷"
  },
  {
    "id": 57,
    "timestamp": "00:02:20,020 --> 00:02:22,380",
    "text": "进攻端哑火的相当严重"
  },
  {
    "id": 58,
    "timestamp": "00:02:22,380 --> 00:02:24,500",
    "text": "自己攻不进去退防又慢"
  },
  {
    "id": 64,
    "timestamp": "00:02:35,860 --> 00:02:38,500",
    "text": "聊聊市场的让步和风控分析"
  },
  {
    "id": 65,
    "timestamp": "00:02:38,500 --> 00:02:41,060",
    "text": "大家盯紧这个数字2.09"
  },
  {
    "id": 66,
    "timestamp": "00:02:41,060 --> 00:02:43,620",
    "text": "这是目前主流机构给SJK开出的"
  },
  {
    "id": 67,
    "timestamp": "00:02:43,620 --> 00:02:45,100",
    "text": "客胜即时赔率"
  },
  {
    "id": 70,
    "timestamp": "00:02:49,780 --> 00:02:52,020",
    "text": "要是光看纸面实力和过往排名"
  },
  {
    "id": 71,
    "timestamp": "00:02:52,020 --> 00:02:54,700",
    "text": "SJK的支持力度本该大的多对吧"
  },
  {
    "id": 72,
    "timestamp": "00:02:54,700 --> 00:02:56,660",
    "text": "但这个2.09偏高的定位"
  },
  {
    "id": 74,
    "timestamp": "00:02:58,260 --> 00:03:00,620",
    "text": "机构根本没有重兵看好客队"
  },
  {
    "id": 76,
    "timestamp": "00:03:02,540 --> 00:03:04,660",
    "text": "严重怀疑SJK到底能不能"
  },
  {
    "id": 79,
    "timestamp": "00:03:09,530 --> 00:03:12,690",
    "text": "虽说SJK过去11次打亚罗赢了7次"
  },
  {
    "id": 81,
    "timestamp": "00:03:14,130 --> 00:03:17,250",
    "text": "但是结合目前的欧转亚数据模型来看"
  },
  {
    "id": 83,
    "timestamp": "00:03:20,330 --> 00:03:23,610",
    "text": "因为客队近期的客场表现实在太软了"
  },
  {
    "id": 84,
    "timestamp": "00:03:23,610 --> 00:03:26,610",
    "text": "所以咱们能看到极其明显的风控动作"
  },
  {
    "id": 85,
    "timestamp": "00:03:26,610 --> 00:03:29,930",
    "text": "尤其是在平局赔率的防御上做足了文章"
  },
  {
    "id": 86,
    "timestamp": "00:03:29,930 --> 00:03:33,330",
    "text": "市场就是要在对冲亚罗最近主场的防守韧性"
  },
  {
    "id": 87,
    "timestamp": "00:03:33,330 --> 00:03:35,690",
    "text": "谁也不敢轻易把宝压在任何一方"
  },
  {
    "id": 92,
    "timestamp": "00:03:41,370 --> 00:03:43,250",
    "text": "瑞超赛场的混乱拆解"
  },
  {
    "id": 94,
    "timestamp": "00:03:44,130 --> 00:03:47,690",
    "text": "韦斯特罗斯坐镇主场迎战厄尔格里特"
  },
  {
    "id": 96,
    "timestamp": "00:03:50,530 --> 00:03:53,690",
    "text": "那这一场咱们就得叫他混沌局了"
  },
  {
    "id": 108,
    "timestamp": "00:04:20,810 --> 00:04:23,970",
    "text": "主打极具侵略性的三四三阵型"
  },
  {
    "id": 109,
    "timestamp": "00:04:23,970 --> 00:04:27,250",
    "text": "他们在客场场均能轰进2.5球"
  },
  {
    "id": 112,
    "timestamp": "00:04:31,250 --> 00:04:33,130",
    "text": "可怜巴巴拿了十分"
  },
  {
    "id": 113,
    "timestamp": "00:04:33,130 --> 00:04:37,170",
    "text": "最可怕的是十三场比赛丢了整整三十一个球"
  },
  {
    "id": 114,
    "timestamp": "00:04:37,170 --> 00:04:39,010",
    "text": "全联赛防守最烂"
  },
  {
    "id": 118,
    "timestamp": "00:04:48,450 --> 00:04:50,970",
    "text": "韦斯特罗斯主打那种快打旋风"
  },
  {
    "id": 119,
    "timestamp": "00:04:50,970 --> 00:04:52,530",
    "text": "边翼位疯狂前插"
  },
  {
    "id": 120,
    "timestamp": "00:04:52,530 --> 00:04:54,530",
    "text": "断球直接长传打身后"
  },
  {
    "id": 123,
    "timestamp": "00:04:57,330 --> 00:05:01,130",
    "text": "防守烂透的厄尔格里特最近居然触底反弹了"
  },
  {
    "id": 124,
    "timestamp": "00:05:01,130 --> 00:05:02,690",
    "text": "还连续爆冷赢球"
  },
  {
    "id": 126,
    "timestamp": "00:05:05,130 --> 00:05:07,130",
    "text": "一个要利用主场狂轰滥炸"
  },
  {
    "id": 127,
    "timestamp": "00:05:07,130 --> 00:05:10,090",
    "text": "一个保级压力巨大绝对不会坐以待毙"
  },
  {
    "id": 130,
    "timestamp": "00:05:15,450 --> 00:05:18,730",
    "text": "主胜赔率直接给到了1.75"
  },
  {
    "id": 131,
    "timestamp": "00:05:18,730 --> 00:05:21,650",
    "text": "结合亚洲让球盘口的资金分布"
  },
  {
    "id": 132,
    "timestamp": "00:05:21,650 --> 00:05:23,570",
    "text": "主场作战的韦斯特罗斯"
  },
  {
    "id": 133,
    "timestamp": "00:05:23,570 --> 00:05:25,970",
    "text": "得到了相当明显的倾斜"
  },
  {
    "id": 135,
    "timestamp": "00:05:29,770 --> 00:05:33,250",
    "text": "就算厄尔格里特刚拿了一场振奋人心的胜利"
  },
  {
    "id": 136,
    "timestamp": "00:05:33,250 --> 00:05:38,610",
    "text": "机构依然死死把主队维持在相对的低水区间严加防范"
  },
  {
    "id": 138,
    "timestamp": "00:05:39,690 --> 00:05:41,370",
    "text": "说明市场更愿意相信"
  },
  {
    "id": 139,
    "timestamp": "00:05:41,370 --> 00:05:43,690",
    "text": "在这种激进对攻的肉搏战里"
  },
  {
    "id": 140,
    "timestamp": "00:05:43,690 --> 00:05:45,130",
    "text": "进攻手段更丰富"
  },
  {
    "id": 141,
    "timestamp": "00:05:45,130 --> 00:05:49,330",
    "text": "战术执行力更强的主队更有机会笑到最后"
  },
  {
    "id": 145,
    "timestamp": "00:05:53,970 --> 00:05:55,420",
    "text": "推演结论"
  },
  {
    "id": 154,
    "timestamp": "00:06:17,060 --> 00:06:19,260",
    "text": "首先芬超那场泥潭局"
  },
  {
    "id": 155,
    "timestamp": "00:06:19,260 --> 00:06:20,420",
    "text": "两边破门乏术"
  },
  {
    "id": 156,
    "timestamp": "00:06:20,420 --> 00:06:21,420",
    "text": "又互相忌惮"
  },
  {
    "id": 157,
    "timestamp": "00:06:21,420 --> 00:06:23,180",
    "text": "大比分基本是不可能了"
  },
  {
    "id": 158,
    "timestamp": "00:06:23,180 --> 00:06:25,220",
    "text": "咱们核心预判个一一平局"
  },
  {
    "id": 159,
    "timestamp": "00:06:25,220 --> 00:06:27,060",
    "text": "双方各队一二险胜"
  },
  {
    "id": 160,
    "timestamp": "00:06:27,060 --> 00:06:29,940",
    "text": "当然要是亚罗反击偷鸡抓住了失误"
  },
  {
    "id": 161,
    "timestamp": "00:06:29,940 --> 00:06:31,820",
    "text": "一零爆冷也是有可能"
  },
  {
    "id": 162,
    "timestamp": "00:06:31,820 --> 00:06:33,740",
    "text": "再说瑞超这局混沌局"
  },
  {
    "id": 163,
    "timestamp": "00:06:33,740 --> 00:06:34,700",
    "text": "两边都不怂"
  },
  {
    "id": 164,
    "timestamp": "00:06:34,700 --> 00:06:36,020",
    "text": "打法极其激进"
  },
  {
    "id": 165,
    "timestamp": "00:06:36,020 --> 00:06:38,020",
    "text": "综合历史交锋的高进球率"
  },
  {
    "id": 166,
    "timestamp": "00:06:38,020 --> 00:06:40,420",
    "text": "这场比赛总进球数超过2.5球"
  },
  {
    "id": 167,
    "timestamp": "00:06:40,420 --> 00:06:42,180",
    "text": "甚至到三球的概率极大"
  },
  {
    "id": 168,
    "timestamp": "00:06:42,180 --> 00:06:43,300",
    "text": "而且胜负天平"
  },
  {
    "id": 169,
    "timestamp": "00:06:43,300 --> 00:06:46,180",
    "text": "更倾向于由主场优势的韦斯特罗斯"
  },
  {
    "id": 175,
    "timestamp": "00:06:56,460 --> 00:06:59,060",
    "text": "赛事分析不可作为投注的标准"
  },
  {
    "id": 178,
    "timestamp": "00:07:02,380 --> 00:07:04,340",
    "text": "看完记得点赞关注"
  },
  {
    "id": 179,
    "timestamp": "00:07:04,340 --> 00:07:05,940",
    "text": "评论区打出你们的预测"
  }
]